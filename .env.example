# Use the Supabase project URL and publishable key only. Never put a secret or
# service-role key in this file or any Vite-exposed variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Backend uses the same public key to verify users and make RLS-scoped requests.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
PORT=3000
NODE_ENV=development
